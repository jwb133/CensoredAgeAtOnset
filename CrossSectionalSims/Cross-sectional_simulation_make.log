Notes:
      1. Stata is running in batch mode.
      2. Unicode is supported; see help unicode_advice.

. do Cross-sectional_simulation_make.do 

. cd Datasets
/home/lshjb12/CensoredAgeAtOnset/CrossSectionalSims/Datasets

. 
. version 18.5

. set seed 398268137

. set sortseed 611887103

. 
. matrix M = (46, 46)

. matrix COV = (81, 48.6 \ 48.6, 81)

. * distributions for actual and parental onset
. 
. forvalues i = 1/10000{
  2. qui{
  3. clear
  4. drawnorm actual_onset parental_onset, n(100) cov(COV) means(M)
  5. label var actual_onset "age at actual onset"
  6. label var parental_onset "age at parental onset"
  7. 
. gen age=40 + rnormal(0,10)
  8. gen id=_n
  9. 
. gen time_rel_actual = age - actual_onset  
 10. label var time_rel_actual "time relative to actual onset"
 11. 
. gen y = 100 + time_rel_actual + rnormal(0,27)
 12. label var y "outcome"
 13. gen y2 = y + age - 40
 14. * generating outcomes
. * parameters chosen to give 90% power to detect a statistically significant (
> p<0.05) slope
. 
. gen time_rel_parental = age - parental_onset
 15. label var time_rel_parental "time relative to parental onset"
 16. 
. gen time_rel_hybrid = time_rel_actual
 17. replace time_rel_hybrid = time_rel_parental if time_rel_actual < 0
 18. label var time_rel_hybrid "time relative to actual onset (if observed), ot
> herwise parental"
 19. 
. gen hybrid_onset = actual_onset
 20. replace hybrid_onset = parental_onset if time_rel_actual < 0
 21. label var time_rel_hybrid "actual onset (if observed), otherwise parental"
 22. 
. gen actual_onset_observed=actual_onset
 23. replace actual_onset_observed = . if actual_onset > age
 24. * in fact actual onset time is unknown if after current age 
. label var actual_onset_observed "actual onset (if observed)"
 25. }
 26. save D`i', replace
 27. }
